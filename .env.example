# Copy this file to .env and fill in real values. .env is gitignored.

# MongoDB connection string.
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tennisbuild
# Local example: mongodb://localhost:27017/tennisbuild
MONGODB_URI=

# Port the Express API server listens on.
PORT=5000

# Secret used to sign auth session tokens (JWTs). Any long random string -
# generate one with `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# Changing this invalidates every existing logged-in session.
JWT_SECRET=
